#!/bin/bash

set -exuo pipefail

LLAMASWAP_CONFIG=@@LLAMASWAP_CONFIG@@
LLAMASWAPCTL=@@LLAMASWAPCTL@@
MODELS_INI=@@MODELS_INI@@

LLAMASWAP_ETC=$(dirname "$LLAMASWAP_CONFIG")

#
# write config.yaml
#

{
    cat <<'EOF'

#
# this file is automatically regenerated by llama-config-refresh
#

healthCheckTimeout: 120
globalTTL: 300
logToStdout: both

models:
EOF

    awk '
        /^\[[^*][^]]*\][[:space:]]*$/ {
            name = $0
            sub(/^[[:space:]]*\[/, "", name)
            sub(/\][[:space:]]*$/, "", name)

            print "  " name ":"
            print "    proxy: \"http://127.0.0.1:${PORT}\""
            print "    cmd: \"sudo -n '"$LLAMASWAPCTL"' start " name " ${PORT}\""
            print "    cmdStop: \"sudo -n '"$LLAMASWAPCTL"' stop " name " ${PORT}\""
        }
    ' "$MODELS_INI"
} > "$LLAMASWAP_CONFIG"

chown root:llamaswap "$LLAMASWAP_CONFIG"
chmod 444 "$LLAMASWAP_CONFIG"
